<% content_for :title, connect_page_title %>

<% if @errors.any? %>
  <%= render FlatPack::Alert::Component.new(
    description: @errors.uniq.join(" "),
    style: :danger
  ) %>
<% end %>

<% if @access_candidates.any? %>
  <%= render FlatPack::Card::Component.new do %>
    <%= render FlatPack::List::Component.new(divider: true) do %>
      <% @access_candidates.each do |recording| %>
        <%= render FlatPack::List::Item.new(
          trailing: connection_status_trailing(recording)
        ) do %>
          <p class="font-medium"><%= connect_row_label(recording) %></p>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <%= render FlatPack::EmptyState::Component.new(
    title: oauth_t("connect.empty_title"),
    description: oauth_t("connect.empty_description"),
    icon: :inbox
  ) %>
<% end %>
