<% credentials_subtitle = if @client_secret.present?
     nil
   elsif @oauth_client.self_registered?
     "This app signed itself up. Connecting still needs a person."
   elsif @oauth_client.confidential?
     "The secret was shown once."
   else
     "Copy the client id. This app has no secret."
   end %>
<% content_for :title, "App credentials" %>
<% content_for :subtitle, credentials_subtitle if credentials_subtitle %>
<% flat_pack_page_nav(
     round: true,
     style: :default,
     back_href: oauth_clients_admin_screen_path,
     back_tooltip: oauth_t("layout.go_back"),
     anchor_href: oauth_clients_admin_screen_path,
     anchor_tooltip: "Close"
   ) %>
<% register_page_nav "Edit", edit_admin_oauth_client_path(@oauth_client), role: :secondary %>

<div class="space-y-6">
  <%= render FlatPack::TextInput::Component.new(
    name: "oauth_client_name",
    label: "Name",
    value: @oauth_client.name,
    quick_copy: true
  ) %>

  <%= render FlatPack::TextInput::Component.new(
    name: "oauth_client_id",
    label: "Client id",
    value: @oauth_client.client_id,
    quick_copy: true
  ) %>

  <%= render FlatPack::TextInput::Component.new(
    name: "oauth_client_api",
    label: "API",
    value: RecordingStudioOauth::Integration.human_api_name(@oauth_client.api_key),
    help_text: "Named API this app uses. A label, not a secret."
  ) %>

  <% if @client_secret.present? %>
    <%= render FlatPack::TextInput::Component.new(
      name: "oauth_client_secret",
      label: "Secret",
      value: @client_secret,
      quick_copy: true
    ) %>
  <% end %>

  <div>
    <%= render FlatPack::Button::Component.new(
      text: "Done",
      style: :primary,
      href: oauth_clients_admin_screen_path
    ) %>
  </div>
</div>
