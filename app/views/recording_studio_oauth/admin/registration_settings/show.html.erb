<% recording_studio_page_nav(
     title: "Registration",
     page_nav_back_url: oauth_clients_admin_screen_path,
     page_nav_anchor_url: oauth_clients_admin_screen_path
   ) %>

<%= render FlatPack::PageTitle::Component.new(
  title: "Registration",
  subtitle: "New apps start with this choice.",
  variant: :h1
) %>

<%= form_with url: admin_registration_setting_path, method: :patch, class: "space-y-6" do %>
  <%= hidden_field_tag "registration_setting[allow_registration]", "0" %>
  <%= render FlatPack::Tooltip::Component.new(
    text: "New apps start with this. Each app can still choose for itself.",
    placement: :top
  ) do %>
    <%= render FlatPack::Checkbox::Component.new(
      name: "registration_setting[allow_registration]",
      label: "Allow registration",
      value: "1",
      checked: @registration_setting.allow_registration?
    ) %>
  <% end %>

  <div>
    <%= render FlatPack::Button::Component.new(
      text: "Save",
      style: :primary,
      type: "submit"
    ) %>
  </div>
<% end %>
