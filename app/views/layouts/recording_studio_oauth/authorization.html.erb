<!DOCTYPE html>
<html <%= tag.attributes(oauth_document_attributes) %>>
  <head>
    <% rs_config = RecordingStudio.configuration %>
    <% app_name = (rs_config.respond_to?(:app_name) ? rs_config.app_name : nil) || oauth_t("layout.connect_title") %>
    <% heading = content_for(:title).to_s.strip.presence %>
    <% subtitle = content_for(:subtitle).to_s.strip.presence %>
    <title><%= heading || app_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "flat_pack/variables", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "flat_pack/rich_text", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= yield :head %>
    <%= javascript_importmap_tags if respond_to?(:javascript_importmap_tags) %>
  </head>
  <body class="bg-(--surface-page-background-color) text-(--surface-content-color)" data-theme="rounded">
    <main class="flex min-h-dvh items-center justify-center p-6">
      <div class="w-full max-w-sm space-y-6">
        <%= flat_pack_page_nav_tag %>
        <% if heading %>
          <%= render FlatPack::PageTitle::Component.new(
            title: heading,
            subtitle: subtitle,
            class: "mb-0 pb-0 text-center"
          ) %>
        <% end %>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
