<% dummy_page_nav(title: "OAuth dummy") %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Connect dummy",
    subtitle: "This host proves the authorization server. API stays the resource server.",
    variant: :h1
  ) %>

  <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
    <% card.body do %>
      <p class="text-sm leading-6">
        Seed Demo App is registered. Connect it to a workspace or folder you can already use.
        Cancel sends the app access denied.
      </p>
    <% end %>
    <% card.footer do %>
      <div class="flex flex-wrap gap-3">
        <%= form_with url: demo_connect_path, method: :post do %>
          <%= render FlatPack::Button::Component.new(
            text: "Connect Seed Demo App",
            style: :primary,
            size: :md,
            type: "submit"
          ) %>
        <% end %>
        <%= render FlatPack::Button::Component.new(
          text: "Connected apps",
          style: :secondary,
          size: :md,
          href: recording_studio_oauth.connected_apps_path
        ) %>
        <%= render FlatPack::Button::Component.new(
          text: "Staff admin",
          style: :ghost,
          size: :md,
          href: "/admin"
        ) %>
      </div>
    <% end %>
  <% end %>

  <% if @oauth_client %>
    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: @oauth_client.name,
          subtitle: "Public app. PKCE S256. Token URL is still the API engine.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>
      <% card.body do %>
        <p class="text-sm leading-6">
          Client id <code><%= @oauth_client.client_id %></code>
        </p>
      <% end %>
    <% end %>
  <% end %>
</div>
